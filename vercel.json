{
  "version": 2,
  "buildCommand": "pip install -r apps/api/requirements.txt && cd apps/api && python -m ml.generate_dummy && python -m ml.train",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": [
          "apps/api/**",
          "data/processed/**",
          "data/ranau.db"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/api/index" }
  ]
}
